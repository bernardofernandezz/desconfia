# Copy to .env and fill in. Without both API keys the app runs in demo mode.

DATABASE_URL=file:../../local.db
# Only for Turso (libsql://…)
DATABASE_AUTH_TOKEN=
# Only outside Vercel, for absolute link-preview URLs
SITE_URL=

# https://app.tavily.com
TAVILY_API_KEY=

# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

# Optional: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACT_CHECK_API_KEY=

# Optional WhatsApp bot: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
