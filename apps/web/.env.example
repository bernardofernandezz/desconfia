# Copy to .env and fill in. Without both API keys the app runs in demo mode.

DATABASE_URL=file:../../local.db

# https://app.tavily.com
TAVILY_API_KEY=

# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

# Optional: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACT_CHECK_API_KEY=
