# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# Tavily search API key (https://app.tavily.com). Without it the app runs in demo mode.
# @optional
TAVILY_API_KEY=

# Google AI Studio key (https://aistudio.google.com/apikey). Without it the app runs in demo mode.
# @optional
GOOGLE_GENERATIVE_AI_API_KEY=

# @optional @sensitive=false
GEMINI_MODEL=gemini-2.5-flash

# Google Fact Check Tools API key (https://console.cloud.google.com/apis/library/factchecktools.googleapis.com). Optional extra source.
# @optional
GOOGLE_FACT_CHECK_API_KEY=
